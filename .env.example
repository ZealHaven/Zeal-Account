# --- runtime ---------------------------------------------------------------
ACCOUNT_ADDR=127.0.0.1:8082
# Where non-API routes are proxied (Vite dev server in dev)
FRONTEND_URL=http://127.0.0.1:5273
# --- OIDC -------------------------------------------------------------------
# Public issuer URL (must match the browser-facing origin)
OIDC_ISSUER=http://localhost:8082
# Session cookie Secure flag (true in prod over HTTPS)
COOKIE_SECURE=false
# 32-byte AES key (hex) — encrypts OIDC signing keys at rest.
# Dev default is used when unset; production MUST set it.
# Generate: openssl rand -hex 32
KEY_ENC_HEX=
# 32+ byte HMAC secret — signs opaque tokens (codes, access/refresh).
# Dev default is used when unset; production MUST set it.
# Generate: openssl rand -hex 32
GLOBAL_SECRET=

# --- infra -----------------------------------------------------------------
DATABASE_URL=postgres://account:account@localhost:5440/account?sslmode=disable
REDIS_URL=redis://localhost:6390/0

# --- SMTP (identity verification codes only) -------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@zealhaven.id
