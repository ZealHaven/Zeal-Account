# --- runtime ---------------------------------------------------------------
ACCOUNT_ADDR=127.0.0.1:8080
# Where non-API routes are proxied (Vite dev server in dev)
FRONTEND_URL=http://127.0.0.1:5273
# Public OIDC issuer (must match the browser-facing origin)
OIDC_ISSUER=http://localhost:8080
# Session cookie Secure flag (true in prod over HTTPS)
COOKIE_SECURE=false

# --- infra -----------------------------------------------------------------
DATABASE_URL=postgres://account:account@localhost:5440/account?sslmode=disable
REDIS_URL=redis://localhost:6390/0

# --- SMTP (identity verification codes only) -------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@zealhaven.id
